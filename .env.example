APP_NAME=PageScan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deine-domain.de

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Datenbank ─────────────────────────────────────────────
# Lokal: sqlite | Produktion: mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pagescan
DB_USERNAME=pagescan
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ─────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@deine-domain.de"
MAIL_FROM_NAME="${APP_NAME}"

# ── Stripe ───────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (monatlich wiederkehrend, je Plan anlegen)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_PRO=price_...

# ── Google Places API ─────────────────────────────────────
# https://console.cloud.google.com → Places API aktivieren
GOOGLE_PLACES_API_KEY=

# ── Google OAuth (für "Mit Google"-Login) ────────────────
# https://console.cloud.google.com → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://deine-domain.de/auth/google/callback

# ── GitHub OAuth (für "Mit GitHub"-Login) ────────────────
# https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://deine-domain.de/auth/github/callback

VITE_APP_NAME="${APP_NAME}"
